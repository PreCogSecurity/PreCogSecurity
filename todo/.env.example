# Copy this file to a private location and export the values in your
# deployment environment. The application reads these variables from ENV;
# it does not load this file automatically.
#
#   export $(grep -v '^#' .env | xargs)   # bash
#   set -a; source .env; set +a           # bash/zsh with dotenv-style file

# Required in production. Generate with: bundle exec rake secret
# Rails refuses to boot in production without this value.
SECRET_KEY_BASE=

# Required in production. Example for PostgreSQL:
#   postgresql://user:password@db.example.com:5432/precog_production
# The app fails to boot in production without this value.
DATABASE_URL=

# Optional. Connection pool size (defaults to 5).
DB_POOL=5

# Optional. Set to "true" to let Rails serve static assets (only needed when
# no reverse proxy / CDN is in front of the app).
RAILS_SERVE_STATIC_FILES=true

# Optional. Set to "true" to log to stdout (useful in containers).
RAILS_LOG_TO_STDOUT=true