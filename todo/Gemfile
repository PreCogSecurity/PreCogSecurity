source 'https://rubygems.org'

# Rails 4.2 is the last release line that supports the Ruby versions this app
# was originally built against. `~> 4.2.11` resolves to the final 4.2.x
# release (4.2.11.3), which includes every backported security fix and is
# compatible with Ruby 2.7 and Bundler 2.x.
gem 'rails', '~> 4.2.11'

gem 'ey_config'
gem 'rails_autolink'
gem 'simple_form'

# Assets
gem 'jquery-rails'
gem 'sass-rails'
gem 'coffee-rails'
gem 'uglifier'

# MRI-only runtime gems. Version pins keep the bundle resolvable on modern
# toolchains (Ruby 2.7 / Bundler 1.x) while staying compatible with Rails 4.2
# and Rack 1.6. Legacy JRuby/Rubinius platform blocks were removed: they are
# unmaintained, break lockfile generation, and this app only deploys on MRI.
gem 'mysql2', '~> 0.5'
gem 'pg', '~> 1.2'
gem 'activerecord-postgis-adapter', '3.0.0.beta2'
gem 'sqlite3', '~> 1.4'

gem 'newrelic_rpm', '~> 6.9'
gem 'unicorn', '~> 5.5'
gem 'puma', '~> 3.12'
gem 'json'
gem 'minitest', '~> 5.14'
gem 'psych', '~> 3.1'
gem 'racc'

# Bundle gems for the local environment. Make sure to
# put test-only gems in this group so their generators
# and rake tasks are available in development mode:
group :development, :test do
  gem 'rubocop', '~> 1.28', :require => false
  gem 'simplecov', '~> 0.17.1', :require => false
end